        "bench:quick": "tsx src/index.ts --quick"
    },
    "dependencies": {
        "@alexandernanberg/rapier2d": "workspace:*",
        "@alexandernanberg/rapier3d": "workspace:*",
        "@dimforge/rapier2d-compat": "^0.20.0",
        "@dimforge/rapier2d-simd-compat": "^0.20.0",
        "@dimforge/rapier3d-compat": "^0.20.0",
        "@dimforge/rapier3d-simd-compat": "^0.20.0"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "mitata": "^1.0.34",
        "tsx": "^4.23.12"
    }
}
